# ============================================
# FICHIER DE CONFIGURATION ENVIRONNEMENT
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gestion_commandes_v2
MYSQL_USER=root
MYSQL_PASSWORD=

# JWT Secret (minimum 32 caractères recommandé)
JWT_SECRET=votre-secret-jwt-super-securise-minimum-32-caracteres

# Compte administrateur créé au premier démarrage si l’email n’existe pas encore
APP_ADMIN_EMAIL=admin@gestion.com
APP_ADMIN_PASSWORD=admin123

# Stripe (Paiements en ligne) — obligatoire pour le checkout carte
# Obtenez vos clés sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# URL du frontend (pour les redirections Stripe)
FRONTEND_URL=http://localhost:4200

# Répertoire d'upload des images
UPLOAD_DIR=uploads
